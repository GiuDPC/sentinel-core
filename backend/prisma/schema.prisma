generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  AWAITING_CONFIRMATION
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Department {
  MANTENIMIENTO_ELECTRICO
  PLOMERIA
  SEGURIDAD
  INFRAESTRUCTURA
  REDES_Y_TELECOMUNICACIONES
  ADMINISTRACION
  OTROS
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String      @id @default(uuid())
  roleId       Int         @map("role_id")
  firstName    String      @map("first_name")
  lastName     String      @map("last_name")
  email        String      @unique
  passwordHash String      @map("password_hash")
  phone        String?
  department   Department?
  storeNumber  String?     @map("store_number")
  storeName    String?     @map("store_name")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  role        Role         @relation(fields: [roleId], references: [id])
  tickets     Ticket[]     @relation("TicketCreator")
  assignments Assignment[]
  comments    Comment[]
  auditLogs   AuditLog[]
  notifications Notification[]

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   // TICKET_STATUS, COMMENT, ASSIGNMENT
  link      String?  // Ruta hacia donde ir al clickear
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Category {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  department Department @default(OTROS)
  slaHours   Int        @map("sla_hours")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("categories")
}

model Ticket {
  id          String         @id @default(uuid())
  ticketCode  String         @unique @map("ticket_code")
  creatorId   String         @map("creator_id")
  categoryId  Int            @map("category_id")
  title       String
  description String
  location    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority
  dueDate        DateTime?      @map("due_date")
  resolutionNote   String?        @map("resolution_note")
  resolvedAt       DateTime?      @map("resolved_at")
  timeSpentMinutes Int?           @map("time_spent_minutes")
  materialsUsed    String?        @map("materials_used")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  creator     User         @relation("TicketCreator", fields: [creatorId], references: [id])
  category    Category     @relation(fields: [categoryId], references: [id])
  assignments Assignment[]
  comments    Comment[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([creatorId])
  @@index([status, dueDate])
  @@index([createdAt])
  @@map("tickets")
}

model Assignment {
  ticketId     String   @map("ticket_id")
  technicianId String   @map("technician_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  ticket     Ticket @relation(fields: [ticketId], references: [id])
  technician User   @relation(fields: [technicianId], references: [id])

  @@id([ticketId, technicianId])
  @@map("assignments")
}

model Comment {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  userId     String   @map("user_id")
  content    String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("comments")
}


model AuditLog {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  action    String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
  @@map("audit_logs")
}
